<%-- Sidebar; iconos como bullet CSS (ASCII) para evitar problemas de fuente/encoding. --%>
<aside class="apf-sidebar" aria-label="Menú principal">
  <div class="apf-sidebar-head">
    <a class="apf-brand" href="${pageContext.request.contextPath}/inicio">
      MedFacil
      <span>Sistema de consulta y repaso de medicamentos</span>
    </a>
  </div>
  <nav class="apf-sidebar-nav">
    <a href="${pageContext.request.contextPath}/inicio" class="apf-sidebar-link ${navSection eq 'inicio' ? 'apf-nav-active' : ''}">
      <span class="apf-sidebar-ico" aria-hidden="true"></span> Inicio
    </a>
    <a href="${pageContext.request.contextPath}/panel" class="apf-sidebar-link ${navSection eq 'panel' ? 'apf-nav-active' : ''}">
      <span class="apf-sidebar-ico" aria-hidden="true"></span> Panel
    </a>
    <a href="${pageContext.request.contextPath}/consulta" class="apf-sidebar-link ${navSection eq 'consulta' ? 'apf-nav-active' : ''}">
      <span class="apf-sidebar-ico" aria-hidden="true"></span> Consulta
    </a>
    <a href="${pageContext.request.contextPath}/medicamentos" class="apf-sidebar-link ${navSection eq 'catalogo' ? 'apf-nav-active' : ''}">
      <span class="apf-sidebar-ico" aria-hidden="true"></span> Catálogo
    </a>
    <a href="${pageContext.request.contextPath}/repaso" class="apf-sidebar-link ${navSection eq 'repaso' ? 'apf-nav-active' : ''}">
      <span class="apf-sidebar-ico" aria-hidden="true"></span> Aprendizaje
    </a>
    <a href="${pageContext.request.contextPath}/consejos" class="apf-sidebar-link ${navSection eq 'consejos' ? 'apf-nav-active' : ''}">
      <span class="apf-sidebar-ico" aria-hidden="true"></span> Consejos
    </a>
  </nav>
  <div class="apf-sidebar-foot">
    <a href="${pageContext.request.contextPath}/index.html">SPA</a>
    <a href="${pageContext.request.contextPath}/h2-console">H2</a>
  </div>
</aside>
<div class="apf-page">
